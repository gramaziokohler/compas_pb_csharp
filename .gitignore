# Build directories - ignore all bin and obj folders anywhere
**/bin/
**/obj/

# Alternative patterns (if the above doesn't work)
# These match variations in casing
**/[Bb]in/
**/[Oo]bj/

# Build outputs
**/Debug/
**/Release/
**/x64/
**/x86/
**/AnyCPU/

# MSBuild temporary files
*.tmp
*.tmp_proj

# Build logs
*.log
*.tlog

# Visual Studio build cache
*.cache
*.pch

# .NET build artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet packages (build outputs)
*.nupkg
*.snupkg

# Test build outputs
**/TestResults/

# Benchmark build outputs
**/BenchmarkDotNet.Artifacts/

# user
*.bin
*.sln

# IDE
.vs/
.idea/

# System files
.DS_Store

# python build outputs
**/dist/
**/build/
**/*.egg-info/


# Generated files
**/Generated/
__pycache__/
