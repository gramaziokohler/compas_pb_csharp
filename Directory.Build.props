<Project>
    <!-- Global compiler settings -->
    <PropertyGroup Label="Compiler Configuration">
        <TargetFrameworks>netstandard2.0;net48;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <WarningsAsErrors />
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- Package metadata -->
    <PropertyGroup Label="Package Information">
        <Authors>Wei-Ting Chen</Authors>
        <Company>Gramaziokohler</Company>
        <Copyright>Copyright © $(Authors) $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/gramaziokohler/compas_pb_csharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/gramaziokohler/compas_pb_csharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>compas;protobuf;serialization;architecture</PackageTags>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- Versioning: Nerdbank.GitVersioning populates Version / AssemblyVersion / -->
    <!-- FileVersion / InformationalVersion automatically from version.json. -->
    <!-- Condition skips legacy packages.config projects. -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"
                          Condition="!Exists('packages.config')" />
    </ItemGroup>

    <!-- Code analysis -->
    <PropertyGroup Label="Code Analysis">
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- Test project settings -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'" Label="Test Project Settings">
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Example project settings -->
    <PropertyGroup
        Condition="$(MSBuildProjectName.Contains('Example')) OR $(MSBuildProjectName.Contains('UserCase'))"
        Label="Example Project Settings"
    >
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
</Project>
