<Project>
    <!-- Include README in package for packable projects -->
    <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildThisFileDirectory)README.md')">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Deterministic build for CI/CD -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Display version info after nbgv populates $(Version). -->
    <!-- Must run AfterTargets="GetBuildVersion" so nbgv has set the version. -->
    <Target Name="DisplayBuildInfo" AfterTargets="GetBuildVersion">
        <Message Importance="high" Text="Building: $(MSBuildProjectName)" />
        <Message Importance="high" Text="Version: $(Version)" />
        <Message Importance="high" Text="Configuration: $(Configuration)" />
    </Target>

    <!-- Validate package after creating it -->
    <Target Name="ValidateNuGetPackage" AfterTargets="Pack" Condition="'$(IsPackable)' != 'false'">
        <Message Importance="high" Text="Package created: $(PackageId).$(PackageVersion).nupkg" />
    </Target>
</Project>
