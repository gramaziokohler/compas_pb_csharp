<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Target Frameworks">
        <TargetFrameworks>netstandard2.0;net48;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Label="Assembly Configuration">
        <AssemblyName>CompasPb</AssemblyName>
        <RootNamespace>CompasPb</RootNamespace>
    </PropertyGroup>

    <ItemGroup Label="Friend Assemblies">
        <InternalsVisibleTo Include="CompasPb.Test" />
    </ItemGroup>

    <PropertyGroup Label="Package Metadata">
        <PackageId>CompasPb</PackageId>
        <Title>COMPAS Protobuf for C#</Title>
        <Description>A COMPAS extension which lets you serialize and deserialize COMPAS Data types using Protocol Buffers.</Description>
    </PropertyGroup>

    <ItemGroup Label="Production Dependencies">
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>

    <!-- Additional packages for net48 -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="System.Net.Http" />
    </ItemGroup>

    <ItemGroup Label="Resources">
        <EmbeddedResource Include="..\..\resources\COMPAS_PB_VERSION.json">
            <LogicalName>COMPAS_PB_VERSION.json</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup Label="Package Files">
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Label="Build Tools">
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>
</Project>
