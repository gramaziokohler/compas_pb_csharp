<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0;net48</TargetFrameworks>
        <IsTestProject>true</IsTestProject>
        <ParallelizeTestCollections>false</ParallelizeTestCollections>
    </PropertyGroup>

    <!-- .NET Framework does not unify assembly versions the way .NET Core does. Google.Protobuf's
         net45 build binds System.Memory 4.0.5.0, while restore resolves System.Memory 4.5.3, whose
         assembly version is 4.0.1.1; without redirects the load fails with a FileLoadException and
         every test dies in discovery. GenerateBindingRedirectsOutputType is needed as well as
         AutoGenerateBindingRedirects because this is a library, not an Exe, and only the pair
         writes CompasPb.Test.dll.config. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net48'" Label="Assembly Binding">
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="../src/CompasPb/CompasPb.csproj" />
    </ItemGroup>

    <ItemGroup Label="Test Dependencies">
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference
            Include="xunit.runner.visualstudio"
            PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
        />
        <PackageReference
            Include="coverlet.collector"
            PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
        />
        <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Label="Proto Definitions">
        <Protobuf Include="Protos/toolpath.proto" GrpcServices="None" />
    </ItemGroup>

    <!-- Explicitly copy the xunit test adapter to the output directory so VSTest can discover it.
         xunit.runner.visualstudio 2.x targets net6.0/net462 and NuGet does not auto-import its
         build props when the project targets net9.0 (resolved via netfx compat fallback).

         Scoped to net9.0 on purpose. Under net48 the package's own net462 props are imported
         correctly, and copying the net6.0 adapter as well overwrites the net462
         xunit.runner.visualstudio.testadapter.dll with a netcoreapp build that .NET Framework
         VSTest cannot load, leaving the net48 run reporting "No test is available". -->
    <ItemGroup Label="Test Adapter" Condition="'$(TargetFramework)' == 'net9.0'">
        <None
            Include="$(NuGetPackageRoot)xunit.runner.visualstudio/2.8.2/build/net6.0/xunit.runner.visualstudio.testadapter.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="$(NuGetPackageRoot)xunit.runner.visualstudio/2.8.2/build/net6.0/xunit.runner.reporters.netcoreapp10.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="$(NuGetPackageRoot)xunit.runner.visualstudio/2.8.2/build/net6.0/xunit.runner.utility.netcoreapp10.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>

    <ItemGroup Label="Interop Fixtures">
        <None Include="Fixtures/compas_pb_1_1_model.b64" CopyToOutputDirectory="PreserveNewest" />
        <None
            Include="Fixtures/compas_pb_1_2_payload.json"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
